# Copy to a private .env file and replace credential placeholders.
# Precedence: CLI > nonempty process environment > literal .env > defaults.
# Values are literal: no interpolation or shell expansion.

# Jev credential. TYPESAFE_API_KEY and TYPESAFE_API_TOKEN are accepted aliases.
JEV_API_KEY=replace-with-your-jev-api-key

# Optional credential; its presence does not select the hosted writer.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Explicit writer provider: ollama or openai.
TREND_CHAT_PROVIDER=ollama

# Separate writer models. OpenAI requires a model only when selected to generate.
TREND_OLLAMA_CHAT_MODEL=qwen3:8b
# Suggested hosted writer; used only when the selected provider is openai.
TREND_OPENAI_CHAT_MODEL=gpt-6.1-sol

# Ingestion uses only the embedding model and loopback Ollama endpoint.
TREND_EMBEDDING_MODEL=bge-m3
TREND_OLLAMA_URL=http://127.0.0.1:11434

# Semantic decision model; also used by evaluate_decisions.py unless overridden.
TREND_JEV_MODEL=jev-latest
